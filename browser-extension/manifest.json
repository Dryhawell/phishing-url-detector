{
  "manifest_version": 3,
  "name": "Phishing URL Detector",
  "version": "1.1.0",
  "description": "Heuristic phishing check + optional deep analysis via local Python API.",
  "action": {
    "default_title": "Phishing URL Detector",
    "default_popup": "popup.html"
  },
  "permissions": ["activeTab", "tabs"],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*"
  ]
}
